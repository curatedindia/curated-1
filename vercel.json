{
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/broadcast",
      "destination": "/api/broadcast"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
